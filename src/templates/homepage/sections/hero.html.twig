<section id="home" class="hero">
    <div class="container">
        <div class="hero-content">
            <div class="hero-profile">
                <img src="{{ preload('/assets/img/profile_photo.jpeg', {as: 'image'}) }}" as="image" alt="Profile" class="hero-avatar">
                <div class="hero-text">
                    <h1 class="hero-name">Robert Ďurica</h1>
                    <p class="hero-bio">PHP Backend Developer building robust web applications and APIs</p>
                    <div class="hero-stats">
                        <div class="stat">
                            <span class="stat-number">5+</span>
                            <span class="stat-label">Years</span>
                        </div>
                        <div class="stat">
                            <span class="stat-number">100%</span>
                            <span class="stat-label">Reliability</span>
                        </div>
                        <div class="stat">
                            <span class="stat-number">10k+</span>
                            <span class="stat-label">Lines Refactored</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
