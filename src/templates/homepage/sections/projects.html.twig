                        <div class="project-visual-mock">
                            <pre><code><span class="com"># docker-compose.yml</span>
<span class="kw">version</span>: <span class="str">'3.8'</span>
<span class="kw">services</span>:
  <span class="key">php</span>:
    <span class="kw">build</span>:
      <span class="kw">context</span>: <span class="str">.docker/php</span>
    <span class="kw">volumes</span>:
