    <span class="kw">networks</span>:
      - <span class="str">app-net</span>

  <span class="key">nginx</span>:
    <span class="kw">image</span>: <span class="str">nginx:alpine</span>
    <span class="kw">ports</span>:
      - <span class="str">"443:443"</span>
    <span class="kw">volumes</span>:
      - <span class="str">.:/var/www/html</span>
