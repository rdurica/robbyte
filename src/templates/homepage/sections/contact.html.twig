<section id="contact" class="contact">
    <div class="container">
        <div class="contact-content">
            <div class="contact-info">
                <h2 class="section-title">Get in Touch</h2>
                <p class="contact-description">
                    I'm currently working full-time, but I'm always open to connecting with like-minded developers and exploring cool side-project ideas or technical discussions.
                </p>
                <div class="contact-methods">
                    <a href="mailto:r.durica@robbyte.net" class="contact-method">
                        <span class="method-label">Email</span>
                        <span class="method-value">r.durica@robbyte.net</span>
                    </a>
                    <a href="https://www.linkedin.com/in/robert-durica/" class="contact-method">
                        <span class="method-label">LinkedIn</span>
                        <span class="method-value">Connect with me</span>
                    </a>
                    <a href="https://github.com/rdurica" class="contact-method">
                        <span class="method-label">GitHub</span>
                        <span class="method-value">View my repositories</span>
                    </a>
                </div>
            </div>
            <div class="contact-form-wrapper">
                {{ form_start(form, {'attr': {'class': 'contact-form', 'id': 'contactForm'}}) }}
                <div class="form-group">
                    {{ form_label(form.name) }}
                    {{ form_widget(form.name, {'attr': {'id': 'name', 'required': true}}) }}
                    <span class="error-message" id="nameError">
                        {{ form_errors(form.name) }}
                     </span>
                </div>

                <div class="form-group">
                    {{ form_label(form.email) }}
                    {{ form_widget(form.email, {'attr': {'id': 'email', 'required': true}}) }}
                    <span class="error-message" id="emailError">
                        {{ form_errors(form.email) }}
                    </span>
                </div>
                <div class="form-group">
                    {{ form_label(form.subject) }}
                    {{ form_widget(form.subject, {'attr': {'id': 'subject', 'required': true}}) }}
                    <span class="error-message" id="subjectError">
                        {{ form_errors(form.subject) }}
                    </span>
                </div>

                <div class="form-group">
                    {{ form_label(form.message) }}
                    {{ form_widget(form.message, {'attr': {'id': 'message', 'rows': 5, 'required': true}}) }}
                    <span class="error-message" id="messageError">
                        {{ form_errors(form.message) }}
                    </span>
                </div>

                {{ form_widget(form.save, {'attr': {'class': 'btn-submit'}}) }}
                <div class="form-status" id="formStatus"></div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</section>
